# Studio build-time configuration.
#
# Copy this file to apps/studio/.env and set the value you need.
# Vite inlines VITE_* variables into the browser bundle, so they are public.
# Never put a secret here.

# Origin of the deployed or local render Worker.
# Leave empty to use the browser-side GitHub fallback.
# VITE_RENDER_API_URL=http://localhost:8787
VITE_RENDER_API_URL=
