{
  "name": "sigil-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @sigil/studio dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "validate:themes": "tsx scripts/validate-themes.ts",
    "check:svg": "tsx scripts/check-svg-size.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.3",
    "tsx": "^4.20.0"
  }
}
